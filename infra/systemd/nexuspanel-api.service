# NexusPanel control plane — UNPRIVILEGED (installer spec §1, §3).
#
# Never runs as root; every privileged operation is a signed Ed25519 command
# to the agent over /run/nexuspanel/agent.sock. Reads its environment from
# /etc/nexuspanel/nexuspanel.env (0640 root:nexuspanel) — keys live under
# /etc/nexuspanel/keys/ (0400/0600 root) and are read-only to this unit.

[Unit]
Description=NexusPanel control plane (NestJS API)
Documentation=https://github.com/backupamunga-ops/nexus_cpanel
After=network-online.target nexuspanel-agent.service
Wants=network-online.target
Requires=nexuspanel-agent.service

[Service]
Type=simple
User=nexuspanel
Group=nexuspanel
WorkingDirectory=/opt/nexuspanel/apps/control-plane
EnvironmentFile=/etc/nexuspanel/nexuspanel.env
# Loopback-only: the public origin (install.sh public-origin) or an SSH tunnel
# proxies to 127.0.0.1 — finding #11 of the live-VM run (see main.ts).
Environment=HOST=127.0.0.1
ExecStart=/usr/bin/node dist/main.js

# Hardening baseline (installer spec §3):
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
LockPersonality=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=yes
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
LimitNOFILE=65535
Restart=on-failure
RestartSec=2s

# :3000 is the API port, bound to 127.0.0.1 via HOST= above. The ufw baseline
# opens only 22/80/443; the public origin proxies 443 → this port.
[Install]
WantedBy=multi-user.target
