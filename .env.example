# NexusPanel control-plane environment (development example)
# Copy to .env and adjust. NEVER commit a real .env.

# --- Core ---
NODE_ENV=development
PORT=3000
GLOBAL_PREFIX=api/v1

# --- Control-plane database (PostgreSQL 16) ---
DATABASE_URL=postgresql://nexuspanel:nexuspanel-dev-only@localhost:5432/nexuspanel

# --- Valkey (queues + rate limiting) ---
VALKEY_URL=redis://localhost:6379

# --- Agent connection ---
# Unix socket presented by the Go agent (dev mode uses a plain socket;
# production uses mTLS with a client certificate signed by the install CA).
AGENT_SOCKET_PATH=/tmp/nexuspanel-agent.sock
AGENT_MTLS_CERT=
AGENT_MTLS_KEY=
AGENT_CA_PATH=

# --- Ed25519 command-signing key (PEM). In production this lives in
# /etc/nexuspanel/keys/ (root-owned, 0400) — never in the repo or env files.
CP_SIGNING_KEY_PATH=./dev-keys/control-plane-signing.key
CP_SECRETS_KEY_PATH=./dev-keys/secrets.key

# --- Auth (C1/C3) ---
# JWT signing secret, >= 32 chars. REQUIRED in production (installer-provisioned,
# never in the repo). If unset in dev, an ephemeral per-boot secret is used and
# tokens do not survive restarts.
AUTH_JWT_SECRET=
# Access token TTL (seconds) — C3 fixed, env-tunable.
ACCESS_TTL_SEC=900
# Session lifetime / lockout policy is ADMIN-RUNTIME config now (D-11): managed
# via the server-settings screen (system_settings table), not env. Defaults:
# security.session_ttl_days=7, security.max_failed_logins=5,
# security.lockout_minutes=15, security.password_min_length=12.

# --- Dev bootstrap admin (development only) ---
# Seeds/refreshes one super-admin in `users` on boot. Leave unset in production.
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
DEV_ADMIN_NAME=Dev Admin

# --- Public origin (ADR-0024) ---
# The panel's own hostname, persisted by `infra/install.sh public-origin`.
# Sites refuses (409) any site/subdomain/alias on this name: agent-managed
# conf.d vhosts load before the panel-origin vhost and would shadow it.
# Leave unset on loopback-only dev boxes.
PANEL_PUBLIC_HOSTNAME=
